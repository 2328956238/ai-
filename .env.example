# ============ 应用 ============
APP_NAME=跨境商品管理 API
APP_VERSION=2.0.0
DEBUG=false
LOG_LEVEL=INFO

# ============ 数据库 ============
# 同步连接串（原有 CRUD / 批量任务使用）
DATABASE_URL=mysql+pymysql://root:root123@localhost:3306/product_db
# 异步连接串（新增工具/会话层使用），留空会自动从 DATABASE_URL 推导
# 本地快速体验也可以用 SQLite：
#   DATABASE_URL=sqlite:///./product.db
#   ASYNC_DATABASE_URL=sqlite+aiosqlite:///./product.db
ASYNC_DATABASE_URL=

# ============ Redis ============
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_TIMEOUT=1.0
CACHE_TTL=300

# ============ AI / LLM ============
# 必填。禁止把真实 Key 提交到代码仓库。
AI_API_KEY=
# OpenAI 兼容地址（示例：DeepSeek 官方 / 超算中心 / SiliconFlow）
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_TIMEOUT=30
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=800

# 工具调用模式：
#   auto   = 先试原生 tools，网关不支持时自动降级到 prompt 模式（推荐）
#   native = 只用原生 tools/tool_calls
#   prompt = 只用提示词 JSON 协议（任何 chat 模型都能跑）
AI_TOOL_MODE=auto
AI_MAX_TOOL_ROUNDS=5

# ============ 会话 ============
CHAT_HISTORY_LIMIT=20
